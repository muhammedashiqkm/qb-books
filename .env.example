# The one place to change how this service is reached and how hard it works.
#
# Read by docker compose automatically, and by run.ps1 for a local run. The
# portal's appsettings.json holds the matching URL ("QbBooks") - a different
# application, and the only other copy of this port.

QB_BOOKS_PORT=8081

# Empty means no check, which is fine on a laptop and not on a server. It must
# match the portal's "QbBooksApiKey".
QB_BOOKS_API_KEY=

# Languages the pages are read in. Both go to every page: the course books are
# Malayalam with English terms in the same line.
QB_BOOKS_OCR_LANGS=mal+eng

# Pages read at once. Leave a core for the rest of the machine.
QB_BOOKS_PAGE_WORKERS=4

# How many read books are kept before the oldest are dropped.
QB_BOOKS_KEEP=20
