# The one place to change how this service is reached and how hard it works.
#
# Read by docker compose automatically, and by run.ps1 for a local run. The
# portal's appsettings.json holds the matching URL ("QbBooks") - a different
# application, and the only other copy of this port.

QB_BOOKS_PORT=8081

# Empty means no check, which is fine on a laptop and not on a server. It must
# match the portal's "QbBooksApiKey".
QB_BOOKS_API_KEY=

# Languages the pages are read in. Every model named here reads EVERY page, so
# this is not a list of what the service can read - it is the work done on each
# page, and the models compete to explain the same marks.
#
# Measured on a 161-page Malayalam book: "mal+eng" takes 2.4 s a page and 99%
# of what comes back is Malayalam; all nine take 16.0 s a page and 96%, the
# missing 3% being letters of other scripts invented on a Malayalam page.
#
# Narrow this to the languages a book really uses whenever the course allows.
QB_BOOKS_OCR_LANGS=ara+eng+fra+hin+mal+san+syr+tam+urd

# Pages read at once. Leave a core for the rest of the machine.
QB_BOOKS_PAGE_WORKERS=4

# How many read books are kept before the oldest are dropped.
QB_BOOKS_KEEP=20
